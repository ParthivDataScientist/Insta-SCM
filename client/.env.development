# Development environment variables for Vite frontend
# This file is safe to commit — it contains no secrets.
# Leave empty: requests go to the Vite dev server and are proxied to the API (vite.config.js → port 8001).
# Avoids net::ERR_CONNECTION_REFUSED when the browser targets localhost:8001 directly while the API is down.
VITE_API_URL=http://localhost:8001

# Set this to your API key if you configured API_KEY in the backend .env
# Leave blank for open dev mode
VITE_API_KEY=
